Options -Indexes
RewriteEngine On

# Admin responses must never be cached by browsers, proxies or CDNs and must
# never be indexed by search engines.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Configuration and one-time migration/setup scripts are include/CLI assets,
# not public web pages.
<FilesMatch "^(config|setup|location-diagnostic)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Clean URLs for admin pages: /admin/login → /admin/login.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]
