Options -Indexes

# PHP files in this directory are shared application components, never public
# pages. Server-side require/include calls continue to work normally.
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
